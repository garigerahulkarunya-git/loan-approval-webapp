# IBM watsonx.ai Credentials — COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER commit your real .env file

# Your IBM Cloud API Key
# Get it from: IBM Cloud Console → Manage → Access (IAM) → API Keys
IBM_API_KEY=your_ibm_cloud_api_key_here

# Your IBM watsonx.ai Deployment Scoring URL
# Format: https://<region>.ml.cloud.ibm.com/ml/v4/deployments/<deployment-id>/predictions
IBM_DEPLOYMENT_URL=https://au-syd.ml.cloud.ibm.com/ml/v4/deployments/019f4f9b-afe0-7265-9d4d-5c8a4f0e790a/predictions

# IBM watsonx.ai API Version (leave as-is)
IBM_VERSION=2021-05-01

# Flask Secret Key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_very_secret_flask_key_here

# Set to false in production
FLASK_DEBUG=false
